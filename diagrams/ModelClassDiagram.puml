@startuml
!include style.puml
skinparam classBackgroundColor MODEL_COLOR_T1
skinparam classFontColor #222222
skinparam classStereotypeFontColor #222222
skinparam classBorderColor #555555
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam linetype ortho
skinparam nodesep 85
skinparam ranksep 60

package "Model" as ModelComponent {
class Model <<interface>>
class ReadOnlyStudentBook <<interface>>
class ReadOnlyUserPrefs <<interface>>
class ModelManager
class StudentBook
class UserPrefs
class UniqueStudentList
class FilteredList<Student>
class Student
class Name
class Phone
class Email
class NusStudentId
class Tag
class FollowUpFlag

ModelManager .up.|> Model
StudentBook .up.|> ReadOnlyStudentBook
ReadOnlyStudentBook -[hidden]down- StudentBook
UserPrefs .up.|> ReadOnlyUserPrefs

' Keep multiplicities beside arrowheads without masking the association lines.
ModelManager *--> "1   " StudentBook
ModelManager *-right-> "1   " UserPrefs
ModelManager *--> "1   " FilteredList
StudentBook *--> "1   " UniqueStudentList
' norank stops this association from pulling Student sideways, and the padding
' and blank lines move its label clear of the line, for MarkBind's PlantUML.
FilteredList -[norank]-> "~*   " Student : shows &#9660;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;\n&#160;\n&#160;
UniqueStudentList --> "~*   " Student : records &#9660;
FilteredList -[hidden]right- UniqueStudentList
Student --> "1   " Name
Student --> "0..1   " Phone
Student --> "0..1   " Email
Student --> "0..1" NusStudentId
Student --> "~*   " Tag : general tags
Student --> "0..1   " FollowUpFlag
FollowUpFlag -right-|> Tag

' Keep value classes in one row so association ends remain vertical.
Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> NusStudentId
NusStudentId -[hidden]right-> FollowUpFlag
FollowUpFlag -[hidden]right-> Tag

}
class " " as Outside #transparent;line:transparent
Outside ..> Model
@enduml
