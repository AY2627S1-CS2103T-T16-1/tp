@startuml
!include style.puml
skinparam defaultFontSize 16
skinparam componentStyle rectangle
skinparam componentFontColor #222222
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam nodesep 45
skinparam ranksep 40

actor User
rectangle TAB {
component Main #EEEEEE
together {
    component UI UI_COLOR_T1
    component Logic LOGIC_COLOR_T1
    component Storage STORAGE_COLOR_T1
}
component Model MODEL_COLOR_T1
component Commons #EEEEEE

Main ..> UI
Main ..> Logic
Main ..> Storage
Main ..> Model
UI .right.> Logic
UI ..> Model
Logic .down.> Model
Logic .right.> Storage
Storage ..> Model

Main -[hidden]right-> Commons
}

artifact "JSON files" as Files
User ..> Main : <color:transparent>__</color>launches
Storage .right.> Files
@enduml
