@startuml
!include style.puml
!pragma layout smetana
skinparam defaultFontSize 16
skinparam componentStyle uml2
skinparam componentFontColor #222222
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam nodesep 45
skinparam ranksep 40

component Main #EEEEEE
component UI UI_COLOR_T1
component Logic LOGIC_COLOR_T1
component Storage STORAGE_COLOR_T1
component Model MODEL_COLOR_T1
component Commons #EEEEEE

Main ..> UI
Main ..> Logic
Main ..> Storage
Main ..> Model
UI ..> Logic
UI ..> Model
Logic ..> Model
Logic ..> Storage
Storage ..> Model

Main -[hidden]right-> Commons
note right of Commons
  Shared utilities used
  across the components
end note
@enduml
