@startuml
!include style.puml
skinparam defaultFontSize 16
skinparam ArrowFontStyle plain
skinparam activityBackgroundColor LOGIC_COLOR_T1
skinparam activityBorderColor #555555
skinparam arrowColor #555555

start
:Fold the typed word with Locale.ROOT;
:Find command words starting with it;
if () then ([prefix matches exist])
  :Use prefix matches as suggestions;
else ([no prefix matches])
  :Find candidates within two edits for the
  same initial character, or one otherwise;
  :Keep candidates at the smallest distance
  (none if there are no candidates);
endif
if () then ([more than three suggestions])
  :Return no suggestions;
else ([at most three suggestions])
  :Return suggestions in command-list order;
endif
stop
@enduml
