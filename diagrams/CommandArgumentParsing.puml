@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16

participant ":AddCommandParser" as parser LOGIC_COLOR
participant "FlagTokenizer" as flags LOGIC_COLOR
participant "CommandTokenizer" as tokens LOGIC_COLOR
participant "c:AddCommand" as command LOGIC_COLOR

[-> parser : parse(args)
activate parser
parser -> flags : tokenize(args, ...)
activate flags
flags -> tokens : tokenize(args)
activate tokens
tokens --> flags : tokens with quoted boundaries
deactivate tokens
note over flags : Assign options to values
flags --> parser : arguments:FlagArgumentMap
deactivate flags
note over parser : Check required input and repeated options
note over parser
  Validate fields through ParserUtil;
  collect errors through ParseProblems.
  Stop on errors; otherwise construct Student.
end note
create command
parser -> command : AddCommand(student)
activate command
command --> parser
deactivate command
[<-- parser : command
deactivate parser
@enduml

