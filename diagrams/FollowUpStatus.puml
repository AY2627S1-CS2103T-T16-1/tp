@startuml
!include style.puml
skinparam defaultFontSize 16
skinparam ArrowFontStyle plain
skinparam activityBackgroundColor LOGIC_COLOR_T1
skinparam activityBorderColor #555555
skinparam arrowColor #555555


start
:Read the follow-up options;
if () then ([an option repeated, or
both -f and -nf given])
  :Reject the
  command;
  stop
else ([else])
  switch ()
  case (<U+00A0><U+00A0>[-f given]<U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0><U+00A0>)
    :Mark the
    follow-up;
  case (<U+00A0><U+00A0>[-nf given])
    :Clear the
    follow-up;
  case (<U+00A0><U+00A0>[neither given])
    :Keep the
    follow-up;
  endswitch
  stop
endif
@enduml
