<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- minWidth is what this window's own content needs rather than a round number: the
     summary panel takes the width its content asks for whatever the window does, and the
     list beside it has a minimum of its own, so below 490 the list is squeezed past that
     and what is in it is cut off at the edge. MainWindowTest checks the window's minimum
     against its content, so if the content changes the check says so. -->
<fx:root type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         title="TAB" minWidth="490" minHeight="600" onCloseRequest="#handleExit">
  <icons>
    <Image url="@/images/address_book_32.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@DarkTheme.css" />
        <URL value="@Extensions.css" />
      </stylesheets>

      <VBox styleClass="window">
        <MenuBar fx:id="menuBar" VBox.vgrow="NEVER">
          <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <MenuItem fx:id="helpMenuItem" mnemonicParsing="false" onAction="#handleHelp" text="Help" />
          </Menu>
        </MenuBar>

        <VBox fx:id="studentPage" VBox.vgrow="ALWAYS" minHeight="0">
          <StackPane VBox.vgrow="NEVER" fx:id="commandBoxPlaceholder" styleClass="command-pane">
            <padding>
              <Insets top="12" right="16" bottom="4" left="16" />
            </padding>
          </StackPane>

          <!-- the reply keeps the height it asks for. A VBox short of room shrinks every
               child, whatever its grow priority, so the reply was squeezed below the rows it
               had been given and what did not fit was cut off -->
          <StackPane VBox.vgrow="NEVER" fx:id="resultDisplayPlaceholder" minHeight="-Infinity">
            <padding>
              <Insets top="6" right="12" bottom="6" left="12" />
            </padding>
          </StackPane>

          <!-- the list yields height before the reply does: it scrolls, so what it cannot
               show is still reachable, where a reply squeezed below the rows it was given is
               simply cut off -->
          <HBox VBox.vgrow="ALWAYS" minHeight="0">
            <StackPane fx:id="summaryPanelPlaceholder" HBox.hgrow="NEVER" />

            <VBox fx:id="studentList" styleClass="student-list-pane" minWidth="340" prefWidth="340"
                  minHeight="0" HBox.hgrow="ALWAYS">
              <padding>
                <Insets top="4" right="16" bottom="8" left="8" />
              </padding>
              <StackPane fx:id="studentListPanelPlaceholder" VBox.vgrow="ALWAYS"/>
            </VBox>
          </HBox>
        </VBox>

        <StackPane fx:id="helpPagePlaceholder" VBox.vgrow="ALWAYS" minHeight="0"
                   visible="false" managed="false" />

        <StackPane fx:id="statusbarPlaceholder" VBox.vgrow="NEVER" />
      </VBox>
    </Scene>
  </scene>
</fx:root>
