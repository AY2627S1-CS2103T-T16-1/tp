<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import seedu.tab.ui.CardHeadline?>
<?import seedu.tab.ui.CardName?>
<?import seedu.tab.ui.TagRow?>

<HBox id="cardPane" fx:id="cardPane" alignment="TOP_LEFT" spacing="12"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="12" right="14" bottom="12" left="14" />
  </padding>

  <Label fx:id="id" styleClass="card-index">
    <minWidth>
      <!-- Ensures that the label text is never truncated -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>

  <VBox fx:id="details" spacing="4" HBox.hgrow="ALWAYS" minWidth="0">
    <CardHeadline>
      <!-- the tags sit against the name, so a reader follows one line from the name to
           what is said about them. The name holds the length the card cuts it to while the
           line has room for it, and gives way with an ellipsis below that. A row of its own
           rather than an HBox, which would share a shortfall between the name and the tags
           and leave neither readable. -->
      <CardName fx:id="name" text="\$first" styleClass="card-name" />
      <TagRow fx:id="tags" />
    </CardHeadline>

    <!-- Each contact gets the full line so a long phone cannot hide an email. Labels may
         shrink with an ellipsis; their tooltips keep the complete contact details readable. -->
    <Label fx:id="nusStudentId" styleClass="card-detail-strong" minWidth="0" />
    <Label fx:id="phone" styleClass="card-detail" text="\$phone" minWidth="0" />
    <Label fx:id="email" styleClass="card-detail" text="\$email" minWidth="0" />
  </VBox>

  <!-- the pill sits outside the row that gives way, at the card's trailing edge, so a long
       name or a row of tags can never push it out of the card. It carries the follow-up
       marker, and takes the age once a follow-up records when it was raised. -->
  <Label fx:id="followUp" styleClass="card-pill" minWidth="-Infinity" />
</HBox>
