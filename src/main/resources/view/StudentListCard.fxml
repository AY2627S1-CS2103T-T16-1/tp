<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="TOP_LEFT" spacing="12"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="12" right="14" bottom="12" left="14" />
  </padding>

  <Label fx:id="id" styleClass="card-index">
    <minWidth>
      <!-- Ensures that the label text is never truncated -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>

  <VBox spacing="4" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT" spacing="8">
      <!-- the name yields only once the row has run out of room, and is elided rather
           than pushing the pill beside it out of the card -->
      <Label fx:id="name" text="\$first" styleClass="card-name" minWidth="40" />
      <!-- prefWrapLength defaults to 400, so the pane would claim that much preferred width
           for a single chip and the name beside it would be squeezed to its minimum -->
      <FlowPane fx:id="tags" minWidth="0" prefWrapLength="1" />
      <Region HBox.hgrow="ALWAYS" minWidth="0" />
      <!-- the trailing pill. It carries the follow-up marker, and takes the age once a
           follow-up records when it was raised -->
      <Label fx:id="followUp" styleClass="card-pill" minWidth="-Infinity" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
      <!-- laid out for the NUS ID, and left out of the card until a student carries one -->
      <Label fx:id="nusId" styleClass="card-detail-strong" />
      <Label fx:id="phone" styleClass="card-detail" text="\$phone" />
      <Label fx:id="email" styleClass="card-detail" text="\$email" />
    </HBox>
  </VBox>
</HBox>
