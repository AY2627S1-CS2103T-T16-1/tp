<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="TOP_LEFT" spacing="12"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="12" right="14" bottom="12" left="14" />
  </padding>

  <Label fx:id="id" styleClass="card-index">
    <minWidth>
      <!-- Ensures that the label text is never truncated -->
      <Region fx:constant="USE_PREF_SIZE" />
    </minWidth>
  </Label>

  <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0">
    <HBox alignment="CENTER_LEFT" spacing="8">
      <!-- the tags sit against the name, so a reader follows one line from the name to what
           is said about them. The name keeps its own width rather than taking the row, and
           the chips take up the slack to its right. Both sides stay bounded: the name never
           falls below a readable stretch, and the card caps how long a name or a chip may
           print. A row rather than a flow pane, because a FlowPane reports its
           prefWrapLength as its preferred width whatever it holds. -->
      <Label fx:id="name" text="\$first" styleClass="card-name" minWidth="120" />
      <HBox fx:id="tags" spacing="6" minWidth="0" alignment="CENTER_LEFT"
            HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
      <!-- laid out for the NUS ID, and left out of the card until a student carries one -->
      <Label fx:id="nusId" styleClass="card-detail-strong" />
      <Label fx:id="phone" styleClass="card-detail" text="\$phone" />
      <Label fx:id="email" styleClass="card-detail" text="\$email" />
    </HBox>
  </VBox>

  <!-- the pill sits outside the row that gives way, at the card's trailing edge, so a long
       name or a row of tags can never push it out of the card. It carries the follow-up
       marker, and takes the age once a follow-up records when it was raised. -->
  <Label fx:id="followUp" styleClass="card-pill" minWidth="-Infinity" />
</HBox>
