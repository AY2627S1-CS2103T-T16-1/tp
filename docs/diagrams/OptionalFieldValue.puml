@startuml
!include style.puml
skinparam defaultFontSize 16
skinparam ArrowFontStyle plain
skinparam activityBackgroundColor LOGIC_COLOR_T1
skinparam activityBorderColor #555555
skinparam arrowColor #555555

title Activity: Decide a field's value
start
if () then ([field not edited])
  :Keep the saved value;
else ([field edited])
  if () then ([new value given])
    :Use the new value;
  else ([no value given])
    :Clear the field;
  endif
endif
stop
@enduml
