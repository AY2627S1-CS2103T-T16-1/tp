@startuml
!include style.puml
skinparam classBackgroundColor LOGIC_COLOR_T1
skinparam classFontColor #222222
skinparam classStereotypeFontColor #222222
skinparam classBorderColor #555555
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam genericDisplay old
skinparam nodesep 45
skinparam ranksep 45

interface Logic <<interface>>
class LogicManager
class StudentBookParser
interface "Parser<T>" as Parser <<interface>>
class DeleteCommandParser
abstract class Command
class DeleteCommand
class CommandResult

LogicManager .up.|> Logic
LogicManager --> "1" StudentBookParser
LogicManager ..> Command : executes
StudentBookParser ..> DeleteCommandParser : creates
DeleteCommandParser .up.|> Parser
DeleteCommandParser ..> DeleteCommand : creates
DeleteCommand -up-|> Command
Command ..> CommandResult : returns

note bottom of DeleteCommandParser
  Implements Parser<DeleteCommand>.
  Other command parsers and commands
  follow the same pattern and are omitted.
end note
@enduml

