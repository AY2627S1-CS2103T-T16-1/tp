@startuml
!include style.puml
!pragma layout smetana
skinparam classBackgroundColor LOGIC_COLOR_T1
skinparam classFontColor #222222
skinparam classStereotypeFontColor #222222
skinparam classBorderColor #555555
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam genericDisplay old
skinparam nodesep 45
skinparam ranksep 45

package "Logic" as LogicComponent {
class Logic <<interface>>
class LogicManager
class StudentBookParser
class "{abstract}\nCommand" as Command
class DeleteCommand
class CommandResult

LogicManager .up.|> Logic
LogicManager --> "1" StudentBookParser
LogicManager ..> Command : executes
StudentBookParser ..> Command : returns
DeleteCommand -up-|> Command
Command .down.> CommandResult : returns
DeleteCommand -[hidden]right-> CommandResult

note bottom of StudentBookParser
  Parser helpers are
  expanded separately.
end note
}

class " " as Outside #transparent;line:transparent
Outside ..> Logic
package "Model" as ModelComponent MODEL_COLOR_T1 {
}
package "Storage" as StorageComponent STORAGE_COLOR_T1 {
}
LogicManager --> ModelComponent
LogicManager -right-> StorageComponent
Command ..right.> ModelComponent : executes against
@enduml

