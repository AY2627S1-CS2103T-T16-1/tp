@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

Class "{abstract}\nCommand" as Command
Class XYZCommand

package "Parser classes"{
Class "<<interface>>\nParser" as Parser
Class StudentBookParser
Class XYZCommandParser
Class FlagArgumentMap
Class FlagTokenizer
Class CommandTokenizer
Class CliFlag
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> StudentBookParser

StudentBookParser .down.> XYZCommandParser: <<create>>

XYZCommandParser ..> XYZCommand : <<create>>
StudentBookParser ..> Command
XYZCommandParser .up.|> Parser
XYZCommandParser ..> FlagArgumentMap
XYZCommandParser ..> FlagTokenizer
FlagTokenizer .left.> FlagArgumentMap
FlagTokenizer ..> CommandTokenizer
FlagArgumentMap -down-> CliFlag
FlagTokenizer .down.> CliFlag
XYZCommand -up-|> Command
@enduml

