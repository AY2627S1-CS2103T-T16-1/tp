@startuml
!include style.puml
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12

start
:Find a student with the same
NUS Student ID;
if (A student with that NUS Student ID exists?) then ([yes])
    :Reject the addition, naming the ID
    and existing student;
    stop
else ([no])
    :Build feedback and append warnings
    for matching name, phone or email;
    :Add the student to the model;
    :Return command result with feedback;
    stop
endif
@enduml

