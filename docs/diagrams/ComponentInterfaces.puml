@startuml
!include style.puml
skinparam classFontColor #222222
skinparam classStereotypeFontColor #222222
skinparam classBorderColor #555555
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam nodesep 45
skinparam ranksep 45

class Ui <<interface>> UI_COLOR_T1
class UiManager UI_COLOR_T1
class Logic <<interface>> LOGIC_COLOR_T1
class LogicManager LOGIC_COLOR_T1
class Model <<interface>> MODEL_COLOR_T1
class ModelManager MODEL_COLOR_T1
class Storage <<interface>> STORAGE_COLOR_T1
class StorageManager STORAGE_COLOR_T1

UiManager .up.|> Ui
LogicManager .up.|> Logic
ModelManager .up.|> Model
StorageManager .up.|> Storage
UiManager --> "1" Logic
LogicManager --> "1" Model
LogicManager --> "1" Storage
@enduml
