@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "c:Command" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute(commandText)
activate LogicManager

LogicManager -> Model : getStudentBook()
activate Model
Model --> LogicManager : book
deactivate Model

LogicManager -> LogicManager : new StudentBook(book)
activate LogicManager
LogicManager --> LogicManager : copy
deactivate LogicManager

LogicManager -> Model : getFilteredStudentPredicate()
activate Model
Model --> LogicManager : filter
deactivate Model

LogicManager -> Command : execute(m)
activate Command
Command --> LogicManager : r
deactivate Command

alt no student record changed
    [<--LogicManager : r

else records changed
    LogicManager -> Storage : saveStudentBook(book)
    activate Storage

    alt save succeeds
        Storage --> LogicManager
        deactivate Storage
        [<--LogicManager : r

    else IOException
        activate Storage
        Storage --> LogicManager : IOException
        deactivate Storage
        LogicManager -> Model : setStudentBook(copy)
        activate Model
        Model --> LogicManager
        deactivate Model

        LogicManager -> Model : updateFilteredStudentList(filter)
        activate Model
        Model --> LogicManager
        deactivate Model

        [<--LogicManager : CommandException
    end
end

deactivate LogicManager
@enduml
