@startuml
!include style.puml
!pragma layout smetana
skinparam classBackgroundColor UI_COLOR_T1
skinparam classFontColor #222222
skinparam classBorderColor #555555
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam nodesep 25
skinparam ranksep 35

class MainWindow
class CommandBox
class ResultDisplay
class StudentListPanel
class StudentCard
class SummaryPanel
class HelpPage
class StatusBarFooter

MainWindow --> "1" CommandBox
MainWindow --> "1" ResultDisplay
MainWindow --> "1" StudentListPanel
MainWindow ..> SummaryPanel : creates
MainWindow --> "1      " HelpPage
MainWindow ..> StatusBarFooter : creates
StudentListPanel ..> StudentCard : creates for visible cells

CommandBox -[hidden]right-> ResultDisplay
ResultDisplay -[hidden]right-> StudentListPanel
SummaryPanel -[hidden]right-> HelpPage
HelpPage -[hidden]right-> StatusBarFooter
@enduml
