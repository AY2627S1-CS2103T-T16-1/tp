@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class HelpPage
Class ResultDisplay
Class StudentListPanel
Class StudentCard
Class SummaryPanel
Class StatusBarFooter
Class CommandBox
Class CommandHistory {
    ~add(command : String) : void
    ~previous(text : String) : String
    ~next(text : String) : String
}
Class CommandTextField
Class CardHeadline
Class CardName
Class TagRow
Class ContactRow
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

Class "javafx.scene.control.TextField" as TextField
Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down->  "1" CommandBox
CommandBox *-down-> "1" CommandHistory
CommandBox *-down-> "1" CommandTextField
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" HelpPage
MainWindow *-down-> "1" StudentListPanel
MainWindow *-down-> "1" SummaryPanel
MainWindow *-down-> "1" StatusBarFooter

StudentListPanel -down-> "*" StudentCard
StudentCard *-down-> "1" CardHeadline
StudentCard *-down-> "1" ContactRow
CardHeadline *-down-> "1" CardName
CardHeadline *-down-> "1" TagRow

MainWindow -left-|> UiPart

HelpPage --|> UiPart
ResultDisplay --|> UiPart
CommandBox --|> UiPart
CommandTextField --|> TextField
StudentListPanel --|> UiPart
StudentCard --|> UiPart
StatusBarFooter --|> UiPart
SummaryPanel --|> UiPart

StudentCard ..> Model
UiManager -right-> Logic
MainWindow -left-> Logic

StudentListPanel -[hidden]left- CommandBox
CommandBox -[hidden]left- ResultDisplay
ResultDisplay -[hidden]left- StatusBarFooter

MainWindow -[hidden]-|> UiPart
@enduml
