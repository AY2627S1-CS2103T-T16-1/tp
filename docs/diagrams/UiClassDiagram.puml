@startuml
!include style.puml
!pragma layout smetana
skinparam classBackgroundColor UI_COLOR_T1
skinparam classFontColor #222222
skinparam classStereotypeFontColor #222222
skinparam classBorderColor #555555
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam nodesep 25
skinparam ranksep 35

package UI {
    interface Ui <<interface>>
    class UiManager
    class MainWindow
    together {
        class CommandBox
        class ResultDisplay
        class StudentListPanel
    }
    class StudentCard
    together {
        class HelpPage
        class SummaryPanel
        class StatusBarFooter
    }

    UiManager .up.|> Ui
    UiManager --> "1" MainWindow
    MainWindow --> "1" CommandBox
    MainWindow --> "1" ResultDisplay
    MainWindow --> "1" StudentListPanel
    MainWindow ..> SummaryPanel : <<create>>
    MainWindow --> "1" HelpPage
    MainWindow ..> StatusBarFooter : <<create>>
    StudentListPanel ..> StudentCard : <<create>>

    CommandBox -[hidden]right-> ResultDisplay
    ResultDisplay -[hidden]right-> StudentListPanel
    HelpPage -[hidden]right-> SummaryPanel
    SummaryPanel -[hidden]right-> StatusBarFooter
    CommandBox -[hidden]down-> HelpPage
    ResultDisplay -[hidden]down-> SummaryPanel
    StudentListPanel -[hidden]down-> StatusBarFooter
}

package "Logic" as LogicComponent LOGIC_COLOR_T1 {
}

package Model MODEL_COLOR_T1 {
}

class " " as Outside #transparent;line:transparent
Outside ..> Ui
UiManager --> LogicComponent
MainWindow --> LogicComponent
StudentCard ..> Model : displays model values
@enduml
