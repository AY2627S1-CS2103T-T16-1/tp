@startuml
!include style.puml
skinparam classBackgroundColor UI_COLOR_T1
skinparam classFontColor #222222
skinparam classStereotypeFontColor #222222
skinparam classBorderColor #555555
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam nodesep 25
skinparam ranksep 35

package UI {
    class Ui <<interface>>
    class UiManager
    class MainWindow
    class CommandBox
    class ResultDisplay
    class StudentListPanel
    class StudentCard
    class HelpPage
    class SummaryPanel
    class StatusBarFooter

    UiManager .up.|> Ui
    UiManager --> "1" MainWindow
    MainWindow -up-> "1" CommandBox
    MainWindow -up-> "1" ResultDisplay
    MainWindow --> "1" StudentListPanel
    MainWindow ..> SummaryPanel : <<create>>
    MainWindow -up-> "1<U+00A0><U+00A0><U+00A0><U+00A0>" HelpPage
    MainWindow ..> StatusBarFooter : <<create>>
    StudentListPanel ..> StudentCard : <<create>>

}

package "Logic" as LogicComponent LOGIC_COLOR_T1 {
}

package Model MODEL_COLOR_T1 {
}

class " " as Outside #transparent;line:transparent
Outside ..> Ui
UiManager --> LogicComponent
MainWindow --> LogicComponent
StudentCard ..> Model : displays model values
@enduml
