@startuml
!include style.puml
skinparam linetype polyline
skinparam nodesep 20
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class HelpPage
Class ResultDisplay
Class StudentListPanel
Class StudentCard
Class SummaryPanel
Class StatusBarFooter
Class CommandBox
}

package Model <<Rectangle>> {
Class StudentSummary
Class HiddenModel #FFFFFF
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .left.|> Ui
UiManager -down-> "\n1" MainWindow
MainWindow *-down->  "\n1" CommandBox
MainWindow *-down-> "\n1" ResultDisplay
MainWindow *-down-> "\n1" HelpPage
MainWindow *-down-> "\n1" StudentListPanel
MainWindow *-down-> "\n1" SummaryPanel
MainWindow *-down-> "\n1" StatusBarFooter

StudentListPanel .down.> StudentCard : <<create>>

MainWindow -left-|> UiPart

HelpPage --|> UiPart
ResultDisplay --|> UiPart
CommandBox --|> UiPart
StudentListPanel --|> UiPart
StudentCard --|> UiPart
StatusBarFooter --|> UiPart
SummaryPanel --|> UiPart

StudentCard .right.> Model
SummaryPanel .right.> StudentSummary
UiManager -right-> Logic
MainWindow -left-> Logic

StatusBarFooter -[hidden]right- ResultDisplay
ResultDisplay -[hidden]right- CommandBox
CommandBox -[hidden]right- HelpPage
HelpPage -[hidden]right- SummaryPanel
SummaryPanel -[hidden]right- StudentListPanel

MainWindow -[hidden]-|> UiPart
@enduml
