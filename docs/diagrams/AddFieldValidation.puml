@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16
skinparam maxMessageSize 260
mainframe sd Add field validation

participant ":AddCommandParser" as parser LOGIC_COLOR
participant ":FlagArgumentMap" as arguments LOGIC_COLOR
participant ":ParseProblems" as problems LOGIC_COLOR
participant "ParserUtil" as util <<class>> LOGIC_COLOR

note left of parser
  1. Reject repeated
  options, create
  the collector
end note
parser -> arguments : verifyNoDuplicateFlagsFor(...)
activate arguments
arguments --> parser
deactivate arguments
create problems
parser -> problems
activate problems
||20||
problems --> parser
deactivate problems
note left of parser
  2a. Read and
  validate
  the name
end note
parser -> arguments : getPreamble()
activate arguments
arguments --> parser : "Alice"
deactivate arguments
parser -> problems : collect(name parsing step)
activate problems
problems -> util : parseName(\n"Alice")
activate util
util --> problems : name
deactivate util
problems --> parser : name
deactivate problems
note left of parser
  2b. Read and
  validate
  the phone
end note
parser -> arguments : getValue(FLAG_PHONE)
activate arguments
arguments --> parser : Optional.of("81234567")
deactivate arguments
parser -> problems : collectIfPresent(phoneText,\nParserUtil::parsePhone)
activate problems
problems -> util : parsePhone(\n"81234567")
activate util
util --> problems : phone
deactivate util
problems --> parser : Optional.of(phone)
deactivate problems
note left of parser
  3. Throw if any
  field failed
end note
parser -> problems : throwIfAny()
activate problems
problems --> parser : no errors
deactivate problems
@enduml
