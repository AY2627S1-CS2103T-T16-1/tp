@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16

actor User as user
participant ":UI" as ui UI_COLOR
participant ":Logic" as logic LOGIC_COLOR
participant ":Model" as model MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

user -> ui : submit "delete 1"
activate ui
ui -> logic : execute("delete 1")
activate logic
note over logic : Parse command
logic -> model : read book and filter
activate model
model --> logic : snapshot data
deactivate model
note over logic : Snapshot book and filter
note over logic : Execute command, resolving displayed target
logic -> model : deleteStudent(student)
activate model
model --> logic
deactivate model
logic -> storage : saveStudentBook(changedBook)
activate storage
storage --> logic
deactivate storage
logic --> ui : CommandResult
deactivate logic
ui --> user : display feedback
deactivate ui
@enduml

