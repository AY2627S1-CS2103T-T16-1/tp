@startuml
!include style.puml
skinparam defaultFontSize 16
skinparam ArrowFontStyle plain
skinparam activityBackgroundColor LOGIC_COLOR_T1
skinparam activityBorderColor #555555
skinparam arrowColor #555555

start
repeat
  :Take the next optional field;
  if () then ([field not edited])
    :Keep the saved value;
  else ([field edited])
    if () then ([new value given])
      :Use the new value;
    else ([no value given])
      :Clear the field;
    endif
  endif
repeat while () is ([more optional fields]) not ([else])
:Build the edited student;
if () then ([same as saved student])
  :Report that nothing changed;
  stop
else ([changed])
  if () then ([ID held by another student])
    :Reject the edit;
    stop
  else ([else])
    :Replace the student\nand report success;
    stop
  endif
endif
@enduml
