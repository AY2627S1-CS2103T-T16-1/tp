@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16
skinparam maxMessageSize 260
mainframe sd Add argument tokenization

participant ":AddCommandParser" as parser LOGIC_COLOR
participant "FlagTokenizer" as flags <<class>> LOGIC_COLOR
participant "CommandTokenizer" as tokens <<class>> LOGIC_COLOR
participant ":FlagArgumentMap" as arguments LOGIC_COLOR

parser -> flags : tokenize(args, ...)
activate flags
flags -> tokens : tokenize(args)
activate tokens
tokens --> flags : tokens with\nquoted boundaries
deactivate tokens
create arguments
flags -> arguments
activate arguments
||20||
arguments --> flags
deactivate arguments
flags -> arguments : setPreamble("Alice")
activate arguments
arguments --> flags
deactivate arguments
flags -> arguments : put(FLAG_PHONE, "-p", "81234567")
activate arguments
arguments --> flags
deactivate arguments
flags --> parser : arguments
deactivate flags
@enduml
