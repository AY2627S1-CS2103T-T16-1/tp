@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16
mainframe sd Parse delete command

participant ":StudentBookParser" as dispatcher LOGIC_COLOR
participant ":DeleteCommandParser" as parser LOGIC_COLOR
participant "c:DeleteCommand" as command LOGIC_COLOR

[-> dispatcher : parseCommand(\n"delete 1")
activate dispatcher
create parser
dispatcher -> parser
activate parser
||20||
parser --> dispatcher
deactivate parser
dispatcher -> parser : parse(" 1")
activate parser
create command
parser -> command
activate command
||20||
command --> parser
deactivate command
parser --> dispatcher : command
deactivate parser
destroy parser
[<-- dispatcher : command
deactivate dispatcher
@enduml
