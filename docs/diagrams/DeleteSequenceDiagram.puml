@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16

participant ":StudentBookParser" as dispatcher LOGIC_COLOR
participant ":DeleteCommandParser" as parser LOGIC_COLOR
participant "c:DeleteCommand" as command LOGIC_COLOR

[-> dispatcher : parseCommand(\n"delete 1")
activate dispatcher
create parser
dispatcher -> parser : new
activate parser
parser --> dispatcher
deactivate parser
dispatcher -> parser : parse(" 1")
activate parser
create command
parser -> command : new(target)
activate command
command --> parser
deactivate command
parser --> dispatcher : command
deactivate parser
destroy parser
[<-- dispatcher : command
deactivate dispatcher
@enduml
