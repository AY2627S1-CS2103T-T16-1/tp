@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16

participant ":LogicManager" as logic LOGIC_COLOR
participant ":StudentBookParser" as dispatcher LOGIC_COLOR
participant ":DeleteCommandParser" as parser LOGIC_COLOR
participant "c:DeleteCommand" as command LOGIC_COLOR
participant ":Model" as model MODEL_COLOR

[-> logic : execute("delete 1")
activate logic
logic -> dispatcher : parseCommand("delete 1")
activate dispatcher
create parser
dispatcher -> parser : «create»
dispatcher -> parser : parse(" 1")
activate parser
create command
parser -> command : «create»
parser --> dispatcher : command
deactivate parser
dispatcher --> logic : command
deactivate dispatcher

note over logic : Snapshot book and filter

logic -> command : execute(model)
activate command
command -> model : read displayed list
activate model
model --> command : displayed students
deactivate model
note over command : Resolve index 1
command -> model : deleteStudent(student)
activate model
model --> command
deactivate model
command --> logic : result
deactivate command

ref over logic, model
  Save changed book or restore snapshot
  (Saving changes safely)
end ref
[<-- logic : result
deactivate logic
@enduml
