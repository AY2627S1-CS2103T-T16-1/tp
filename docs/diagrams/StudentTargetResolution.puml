@startuml
!include style.puml
skinparam defaultFontSize 16
skinparam ArrowFontStyle plain
skinparam activityBackgroundColor LOGIC_COLOR_T1
skinparam activityBorderColor #555555
skinparam arrowColor #555555

start
:Resolve the parsed StudentTarget;
if (Target type?) then ([index])
  :Read the displayed student list;
  if (Index within the list?) then ([yes])
    :Select the student at that position;
  else ([no])
    :Throw CommandException\nwith index feedback and any ID hint;
    stop
  endif
else ([NUS Student ID])
  :Search the entire student book\nfor the normalized ID;
  if (Matching student found?) then ([yes])
    :Select the matching student;
  else ([no])
    :Throw CommandException\nidentifying the missing ID;
    stop
  endif
endif
:Return the selected Student;
stop
@enduml
