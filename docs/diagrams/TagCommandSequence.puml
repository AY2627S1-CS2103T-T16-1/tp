@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16

participant "c:TagCommand" as command LOGIC_COLOR
participant "target:StudentTarget" as target LOGIC_COLOR
participant ":Model" as model MODEL_COLOR
participant "student:Student" as student MODEL_COLOR
participant "updatedStudent:Student" as updated MODEL_COLOR

[-> command : execute(model)
activate command
command -> target : resolve(model, ID_TARGET_COMMAND)
activate target
target -> model : getFilteredStudentList()
activate model
model --> target : displayed students
deactivate model
target --> command : student at index 1
deactivate target
command -> student : getTags()
student --> command : stored tags
opt no tag matches T1, ignoring case
command -> command : withTagAdded(student)
activate command
command -> student : getTags()
student --> command : stored tags
create updated
command -> updated : Student(name, phone, email, id,\nupdatedTags, isFlagged)
activate updated
updated --> command
deactivate updated
deactivate command
command -> model : setStudent(student, updatedStudent)
activate model
model --> command
deactivate model
[<-- command : result
end
deactivate command
@enduml

