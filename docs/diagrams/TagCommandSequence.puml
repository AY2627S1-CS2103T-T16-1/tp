@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16

participant "c:TagCommand" as command LOGIC_COLOR
participant "target:StudentTarget" as target LOGIC_COLOR
participant ":Model" as model MODEL_COLOR

[-> command : execute(model)
activate command
command -> target : resolve(model, ID_TARGET_COMMAND)
activate target
target -> model : getFilteredStudentList()
activate model
model --> target : displayed students
deactivate model
note over target : Select index 1
target --> command : student
deactivate target
note over command
  Check that tag T1 is absent, ignoring case.
  Copy tags and construct replacement student.
  Feedback starts "Added tag [T1]:".
end note
command -> model : setStudent(student, updatedStudent)
activate model
model --> command
deactivate model
[<-- command : result
deactivate command
@enduml

