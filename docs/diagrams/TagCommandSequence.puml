@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 16

participant "c:\nTagCommand" as command LOGIC_COLOR
participant "target:\nStudentTarget" as target LOGIC_COLOR
participant ":Model" as model MODEL_COLOR
participant "student:\nStudent" as student MODEL_COLOR
participant "updated:\nStudent" as updated MODEL_COLOR

[-> command : execute(model)
activate command
command -> target : resolve(model,\nID_TARGET_COMMAND)
activate target
target --> command : student
deactivate target
command -> student : getTags()
activate student
student --> command : stored tags
deactivate student
alt no tag matches T1
command -> command : withTagAdded(student)
activate command
command -> student : getTags()
activate student
student --> command : stored tags
deactivate student
create updated
command -> updated
activate updated
||20||
updated --> command
deactivate updated
deactivate command
command -> model : setStudent(student, updated)
activate model
model --> command
deactivate model
[<-- command : result
else T1 already present
[<-- command : CommandException
end
deactivate command
@enduml

