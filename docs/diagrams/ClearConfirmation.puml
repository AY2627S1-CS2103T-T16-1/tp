@startuml
!include style.puml
!pragma layout smetana
skinparam defaultFontSize 16
skinparam ArrowFontStyle plain
skinparam stateBackgroundColor LOGIC_COLOR_T1
skinparam stateBorderColor #555555
skinparam stateFontColor #222222
skinparam arrowColor #555555

state "No pending confirmation" as Idle
state "Awaiting clear reply" as Pending

[*] --> Idle
Idle -left-> Idle : clear [empty]\n/ report empty
Idle -down-> Pending : clear [nonempty]\n/ show prompt
Pending -right-> Pending : invalid reply\n/ repeat prompt
Pending -left-> Idle : n, no, or empty\n/ cancel
Pending -up-> Idle : y or yes\n/ clear and save
@enduml
