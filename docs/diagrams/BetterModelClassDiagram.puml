@startuml
!include style.puml
skinparam linetype ortho
skinparam nodesep 20
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

StudentBook *-right-> "1" UniqueStudentList
StudentBook *-right-> "1" UniqueTagList
UniqueTagList -[hidden]down- UniqueStudentList

UniqueTagList -right-> "*" Tag
UniqueStudentList -right-> "*" Student

Student -up-> "*" Tag

Student *--> Name
Student *--> "0..1" Phone
Student *--> "0..1" Email
Student *--> "0..1" NusStudentId
Student *--> "0..1" FollowUpFlag
FollowUpFlag --|> Tag
' NusStudentId sits on a rank of its own, so its multiplicity is not drawn
' on the horizontal run the other field associations share.
Name -[hidden]down- NusStudentId
@enduml

