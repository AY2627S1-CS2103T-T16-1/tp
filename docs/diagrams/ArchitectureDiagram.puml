@startuml
!include style.puml
!pragma layout smetana
skinparam defaultFontSize 16
skinparam packageFontColor #222222
skinparam arrowColor #555555
skinparam ArrowFontStyle plain
skinparam nodesep 45
skinparam ranksep 40

package Main #EEEEEE
package UI UI_COLOR_T1
package Logic LOGIC_COLOR_T1
package Storage STORAGE_COLOR_T1
package Model MODEL_COLOR_T1
package Commons #EEEEEE

Main ..> UI
Main ..> Logic
Main ..> Storage
Main ..> Model
UI ..> Logic
UI ..> Model
Logic ..> Model
Logic ..> Storage
Storage ..> Model

Main -[hidden]right-> Commons
note right of Commons
  Shared utilities used
  across the components
end note
@enduml
