@startuml
!include style.puml
skinparam defaultFontSize 16
skinparam ArrowFontStyle plain
skinparam activityBackgroundColor STORAGE_COLOR_T1
skinparam activityBorderColor #555555
skinparam arrowColor #555555

start
:Resolve data target and sibling lock path;
if (Save lock acquired?) then (yes)
  :Reload and validate disk book;
  if (Disk book matches remembered baseline?) then (yes)
    :Carry forward current disk comment;
    :Serialize and atomically replace file;
    :Remember successfully saved book;
    :Release lock;
    stop
  else (no)
    :Release lock;
    :Report stale data;
    stop
  endif
else (no)
  :Report lock failure or busy save;
  stop
endif

legend bottom
  I/O or validation failure aborts the save.
  An acquired lock is released on every exit.
  Logic restores the book and filter on save failure.
endlegend
@enduml
